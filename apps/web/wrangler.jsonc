{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paillette",
  "main": "./worker.ts",
  "compatibility_date": "2026-05-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./build/client",
    "not_found_handling": "single-page-application",
  },
  "routes": [
    {
      "pattern": "paillette.berlayar.ai",
      "custom_domain": true,
    },
  ],
  "vars": {
    "APP_ENV": "production",
    "PAILLETTE_API_URL": "https://paillette-api.berlayar.ai",
    "PAILLETTE_FEEDBACK_FROM": "Paillette <noreply@berlayar.ai>",
  },
  "env": {
    "staging": {
      "name": "paillette-stg",
      "assets": {
        "directory": "./build/client",
        "not_found_handling": "single-page-application",
      },
      "routes": [
        {
          "pattern": "paillette-stg.berlayar.ai",
          "custom_domain": true,
        },
      ],
      "vars": {
          "APP_ENV": "staging",
          "PAILLETTE_API_URL": "https://paillette-api-stg.berlayar.ai",
          "PAILLETTE_FEEDBACK_FROM": "Paillette <noreply@berlayar.ai>",
      },
    },
  },
}
